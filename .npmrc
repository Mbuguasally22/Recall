# openai's "peerOptional zod@^3.23.8" conflicts with this project's
# zod@^4.x (used for our own validation, not openai's unused structured-
# output helper). legacy-peer-deps keeps that from blocking npm install
# locally AND on Vercel, which otherwise fails the build with
# `Command "npm install" exited with 1`.
legacy-peer-deps=true
